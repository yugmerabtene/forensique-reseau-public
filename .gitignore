# Dépendances opencode (ne pas versionner)
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock

# Secrets (ne JAMAIS versionner)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519
.netrc
.npmrc
.pypirc
credentials
credentials.*
secrets.*
secrets/
*_rsa
*_dsa
*_ed25519
*.ovpn
*.kdbx
*.crt

# Fichiers temporaires
*.tmp
*.swp
__pycache__/
*.pyc

# Artefacts de construction des PDF (regenere par
# .opencode/scripts/export-pdf.sh). Seuls le script et le fragment de mise en
# page sont versionnes, pour que le rendu soit reproductible.
/export/

# Paquets .deb telecharges pour l'image du laboratoire (regenere par
# .opencode/lab/telecharger-paquets.sh, plusieurs centaines de Mo)
.opencode/lab/debs/

# Captures et journaux produits par un execution reelle du laboratoire. Ce sont
# des preuves d'incident simulees, jamais des livrables du cours, et elles ne
# doivent jamais se retrouver dans un depot.
/captures/
/journaux/

# Projet anterieur archive dans le repertoire de travail. Il ne fait pas partie
# de la formation Forensique reseau et n'a rien a y etre versionne.
/old/

# Copie du syllabus de travail. La version versionnee est syllabus-original.txt,
# extraite de la plateforme et verifiee. Les deux fichiers sont identiques au
# moment du regroupement ; un seul est suivi.
/syllabus.txt

# Journal de session opencode Waxdrop dans le repertoire de travail. Il porte
# sur une autre formation, le cours d'IA, et ne appartient pas a Forensique
# reseau. Il est ecarte du depot pour qu'aucun contenu etranger ne s'y glisse.
/session-ses_*.md
